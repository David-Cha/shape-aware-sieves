module purge
module load gcc libxkbcommon libxi mesa

eval "$(conda shell.bash hook)"
conda activate sieves-kaolin

python /home1/jaeyoonc/sieves-kaolin/figures/render_opt_iters_vis.py \
       /home1/jaeyoonc/sieves-kaolin/scripts/67223_vs_591211.json
module purge

eval "$(conda shell.bash hook)"
conda activate sieves-kaolin

python /home1/jaeyoonc/sieves-kaolin/scripts/generate_sieve.py \
       32770_vs_30_random_B_meshes.json \
       /home1/jaeyoonc/sieves-kaolin/results/32770_vs_30_random_B_meshes
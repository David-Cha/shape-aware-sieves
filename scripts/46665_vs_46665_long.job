module purge

eval "$(conda shell.bash hook)"
conda activate sieves-kaolin

python /home1/jaeyoonc/sieves-kaolin/scripts/generate_sieve.py \
       /home1/jaeyoonc/sieves-kaolin/scripts/46665_vs_46665_long.json \
       /home1/jaeyoonc/sieves-kaolin/results/46665_vs_46665_long
